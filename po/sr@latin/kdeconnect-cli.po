#: kdeconnect-cli.cpp:37
#, kde-format
msgid ""
"No device specified: Use -d <Device ID> or -n <Device Name> to specify a "
"device. \n"
"Device ID's and names may be found using \"kdeconnect-cli -l\" \n"
"View complete help with --help option"
msgstr ""
"Nije naveden uređaj: upotrebite -d <Device ID> ili -n <Device Name> da biste "
"naveli uređaj. \n"
"ID‑ove i nazive uređaja možete naći pomoću „kdeconnect-cli -l“ \n"
"Potpunu pomoć vidite opcijom --help"

#: kdeconnect-cli.cpp:57
#, kde-format
msgid "KDE Connect CLI tool"
msgstr "KDE‑konekcijina alatka komandne linije"

#: kdeconnect-cli.cpp:59
#, kde-format
msgid "© 2015–2025, KDE Connect Team"
msgstr "© 2015–2025, tim KDE‑konekcije"

#: kdeconnect-cli.cpp:60
#, kde-format
