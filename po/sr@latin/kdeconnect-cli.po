#: kdeconnect-cli.cpp:67
#, kde-format
msgid "List all devices"
msgstr "prikazuje sve uređaje"

#: kdeconnect-cli.cpp:69
#, kde-format
msgid "List available (paired and reachable) devices"
msgstr "prikazuje dostupne (uparene i povezive) uređaje"

#: kdeconnect-cli.cpp:70
#, kde-format
msgid "List all backends and status"
msgstr "prikazuje sve pozadine i njihovo stanje"

#: kdeconnect-cli.cpp:71
#, kde-format
msgid "Enable the specified backend"
msgstr "uključuje navedenu pozadinu"

#: kdeconnect-cli.cpp:71 kdeconnect-cli.cpp:72
#, kde-format
msgid "backend"
msgstr "pozadina"

#: kdeconnect-cli.cpp:72
#, kde-format
msgid "Disable the specified backend"
msgstr "isključuje navedenu pozadinu"

#: kdeconnect-cli.cpp:74
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id, to ease "
"scripting"
msgstr ""
"omogućava da --list-devices ili --list-available prikazuju samo ID uređaja, "
"što olakšava skriptovanje"

#: kdeconnect-cli.cpp:76
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices name, to ease "
"scripting"
msgstr ""
"omogućava da --list-devices ili --list-available prikazuju samo naziv "
"uređaja, što olakšava skriptovanje"

#: kdeconnect-cli.cpp:78
#, kde-format
msgid ""
"Make --list-devices or --list-available print only the devices id and name, "
"to ease scripting"
msgstr ""
"omogućava da --list-devices ili --list-available prikazuju samo ID i naziv "
"uređaja, što olakšava skriptovanje"

#: kdeconnect-cli.cpp:79
#, kde-format
msgid "Search for devices in the network and re-establish connections"
msgstr "traži uređaje na mreži i ponovo uspostavlja veze"

#: kdeconnect-cli.cpp:80
#, kde-format
msgid "Request pairing with device"
msgstr "zahteva uparivanje sa uređajem"

#: kdeconnect-cli.cpp:81
#, kde-format
msgid "Find device by ringing it"
msgstr "nalazi uređaj zvonjavom"

#: kdeconnect-cli.cpp:82
#, kde-format
msgid "Unpair from device"
msgstr "rasparuje uređaj"

#: kdeconnect-cli.cpp:83
#, kde-format
msgid "Send ping to device"
msgstr "šalje ping uređaju"

#: kdeconnect-cli.cpp:84
#, kde-format
msgid "Same as ping but you can set the message to display"
msgstr "isto kao ping ali može da pošalje proizvoljnu poruku"

#: kdeconnect-cli.cpp:84 kdeconnect-cli.cpp:91
#, kde-format
msgid "message"
msgstr "poruka"

#: kdeconnect-cli.cpp:85
#, kde-format
msgid "Send clipboard to device"
msgstr "šalje sadržaj klipborda uređaju"

#: kdeconnect-cli.cpp:86
#, kde-format
msgid "Share file/URL to device"
msgstr "deli fajl ili URL sa uređajem"

#: kdeconnect-cli.cpp:87
#, kde-format
msgid "Share text to device"
msgstr "deli tekst sa uređajem"

#: kdeconnect-cli.cpp:88
#, kde-format
msgid "Display notifications on device"
msgstr "prikazuje obaveštenja na uređaju"

#: kdeconnect-cli.cpp:89
#, kde-format
msgid "Lock the specified device"
msgstr "zaključava navedeni uređaj"

#: kdeconnect-cli.cpp:90
#, kde-format
msgid "Unlock the specified device"
msgstr "otključava navedeni uređaj"

#: kdeconnect-cli.cpp:91
#, kde-format
msgid "Sends an SMS. Requires destination"
msgstr "šalje SMS, zahteva odredišni broj"

#: kdeconnect-cli.cpp:92
#, kde-format
msgid "Phone number to send the message"
msgstr "broj telefona na koji se šalje poruka"

#: kdeconnect-cli.cpp:92
#, kde-format
msgid "phone number"
msgstr "broj telefona"

#: kdeconnect-cli.cpp:94
#, kde-format
msgid ""
"File URLs to send attachments with the message (can be passed multiple times)"
msgstr ""
"URL‑ovi fajlova koji se šalju kao prilozi uz poruku (može se zadati više "
"puta)"

#: kdeconnect-cli.cpp:95
#, kde-format
msgid "file URLs"
msgstr "URL‑ovi fajlova"

#: kdeconnect-cli.cpp:96
#, kde-format
msgid "Device ID"
msgstr "ID uređaja"

#: kdeconnect-cli.cpp:97
#, kde-format
msgid "Device Name"
msgstr "naziv uređaja"

#: kdeconnect-cli.cpp:98
#, kde-format
msgid "Get encryption info about device"
msgstr "dobavlja podatke o šifrovanju za uređaj"

#: kdeconnect-cli.cpp:99
#, kde-format
msgid "List remote commands and their ids"
msgstr "izlistava udaljene naredbe i njihove ID‑ove"

#: kdeconnect-cli.cpp:100
#, kde-format
msgid "Execute remote command by id"
msgstr "izvršava udaljenu naredbu po ID‑u"

#: kdeconnect-cli.cpp:101
#, kde-format
msgid "Send keys to device"
msgstr "šalje tastere uređaju"

#: kdeconnect-cli.cpp:102
#, kde-format
msgid "Display this device's id and exit"
msgstr "prikazuje ID ovog uređaja i izlazi"

#: kdeconnect-cli.cpp:104
#, kde-format
msgid "Browse the filesystem of a said device"
msgstr "pregleda fajl sistem navedenog uređaja"

#: kdeconnect-cli.cpp:106
#, kde-format
msgid "Mount filesystem of a said device"
msgstr "montira fajl sistem navedenog uređaja"

#: kdeconnect-cli.cpp:107
#, kde-format
msgid "Print mount point for the filesystem of a said device"
msgstr "ispisuje tačku montiranja fajl sistema navedenog uređaja"

